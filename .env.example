# Wallet (alamat publik saja; private key TIDAK pernah di file ini)
DEPLOYER_ADDRESS=0x1f4cD14B5CDD15436950d626CBCb0e21084F462D
AGENT_ADDRESS=0x35Ca52DAd343a80A3Be6b09091B74Dd3e5864561
TREASURY_ADDRESS=0xb71e729b85908195B77Bd927554e8FC8dfF8CE84

# Chain
CHAIN_ENV=localhost
RPC_URL=http://127.0.0.1:8545

# Database
DATABASE_URL=postgres://nexa:nexa@localhost:5432/nexa

# Posting
X_POST_MODE=dry

# LLM (Xiaomi MiMo; kosong = mock LLM)
LLM_PROVIDER=mimo
LLM_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
LLM_API_KEY=
LLM_MODEL_SMALL=mimo-v2.6-flash
LLM_MODEL_LARGE=mimo-v2.6-pro

# API
WEB_ORIGIN=http://localhost:3000
PAID_FEATURES_ENABLED=false
HOLDER_THRESHOLD=

# Worker
# Kunci 32 byte hex untuk enkripsi preimage prediksi (salt). Buat: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PREIMAGE_KEY=
NEXA_LEDGER_ADDRESS=
# Diisi manusia langsung di dashboard Railway (service worker) / shell lokal. JANGAN pernah ditulis di file ini.
# AGENT_PRIVATE_KEY=

# Web (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_USE_FIXTURES=true
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Handle akun X NEXA tanpa "@" (belum diberikan; kosong = tautan "Follow on X" menjadi "#")
NEXT_PUBLIC_X_HANDLE=
# Hanya server: pilih varian fixture /proof ("populated" untuk dev/test pengikatan data)
FIXTURE_PROOF=

# Telegram (alert Pro + kanal cadangan). Diisi manusia; kosong = mode dry (hanya log)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Kontrak fee (Tahap 4). Semua alamat publik.
# Aset pasangan: NVDA Stock Token (belum terverifikasi; lihat BLOCKERS)
PAIR_ASSET=
KEEPER_ADDRESS=
# Indexer Pons V2 (apps/indexer). CHAIN_ENV=mainnet memakai alamat di packages/shared/src/chains.ts
INDEXER_START_BLOCK=
INDEXER_CHUNK_BLOCKS=2000
INDEXER_POLL_SECONDS=5
HIGH_CREATOR_TAX_BPS=500
# Ask NEXA (POST /ask, berbayar): penerima pembayaran USDG (default TREASURY_ADDRESS) dan harga minimum (1000000 = $1, USDG 6 desimal)
ASK_PAYMENT_RECIPIENT=
ASK_PRICE_USDG_MICROS=1000000
ASK_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Harga LLM per 1 juta token dalam USD micro (1000000 = $1). Kosong = harga sementara MiMo v2.6 di apps/worker/src/llm.ts
LLM_PRICE_SMALL_IN_USD_MICROS=
LLM_PRICE_SMALL_OUT_USD_MICROS=
LLM_PRICE_LARGE_IN_USD_MICROS=
LLM_PRICE_LARGE_OUT_USD_MICROS=
# Web: alamat pembayaran publik untuk halaman Ask NEXA (treasury; kosong = teks "ditampilkan saat dibuka")
NEXT_PUBLIC_ASK_PAYMENT_ADDRESS=
# Prediction of the Day (worker): jam UTC mulai dan aset (JSON). Kosong = aset mainnet bila CHAIN_ID=4663. Feed aset harus terdaftar di NexaLedger (setFeed).
DAILY_PREDICTION_HOUR_UTC=9
PREDICTION_ASSETS=
